# Copy these values into the deployment platform's secret/configuration store.
# Do not commit the populated version.
NODE_ENV=staging
PORT=3001
WEB_URL=https://contracts-staging.example.com
DATABASE_URL=postgresql://contracts:<password>@<postgres-host>:5432/contracts
AUTH_MODE=oidc
OIDC_ISSUER_URL=https://identity.example.com/realms/contracts-staging
OIDC_CLIENT_ID=bytecrunch-contracts-staging
OIDC_CLIENT_SECRET=<secret>
OIDC_REDIRECT_URI=https://api.contracts-staging.example.com/auth/callback
SESSION_SECRET=<unique-random-value-at-least-32-characters>
PLUGIN_ENCRYPTION_KEY=<stable-unique-random-value-at-least-32-characters>
WEBHOOK_SIGNING_SECRET=<unique-random-value-at-least-32-characters>
RATE_LIMIT_SECRET=<unique-random-value-at-least-32-characters>
METRICS_TOKEN=<unique-random-value-at-least-32-characters>
TRUST_PROXY=true
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_FROM="Bytecrunch Contracts <contracts@example.com>"
SIGNING_MODE=development
PDF_SEAL_MODE=development
PDF_SEAL_NAME=ByteCrunch Contracts Staging
PDF_SEAL_LOCATION=Copenhagen, Denmark
PDF_SEAL_CONTACT=contracts@example.com
ARTIFACT_STORAGE_DRIVER=filesystem
ARTIFACT_STORAGE_PATH=/var/lib/bytecrunch/artifacts
ARTIFACT_RETENTION_DAYS=2555
DELIVERY_MAX_ATTEMPTS=10
WEBAUTHN_RP_ID=contracts-staging.example.com
WEBAUTHN_ORIGIN=https://contracts-staging.example.com
