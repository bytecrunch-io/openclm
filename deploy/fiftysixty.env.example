NODE_ENV=production
PORT=3001
WEB_URL=https://contracts.fiftysixty.com
PUBLIC_API_URL=https://api.contracts.fiftysixty.com
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://contracts:CHANGE_URL_ENCODED_PASSWORD@postgres:5432/contracts
AUTH_MODE=oidc

# Cognito is the OIDC authority; Google remains an upstream Cognito provider.
OIDC_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_GRQprkT1P
OIDC_AUTHORIZATION_ENDPOINT=https://auth.fiftysixty.com/oauth2/authorize
OIDC_TOKEN_ENDPOINT=https://auth.fiftysixty.com/oauth2/token
OIDC_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_GRQprkT1P/.well-known/jwks.json
OIDC_CLIENT_ID=CREATE_A_DEDICATED_COGNITO_APP_CLIENT
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=https://api.contracts.fiftysixty.com/auth/callback

# Optional unattended migration path. Leave unset to use UI onboarding.
# BOOTSTRAP_ENTITY_ID=fiftysixty
# BOOTSTRAP_ENTITY_SLUG=fiftysixty
# BOOTSTRAP_ENTITY_LEGAL_NAME=FiftySixty ApS
# BOOTSTRAP_ENTITY_BUSINESS_ADDRESS=
# BOOTSTRAP_ENTITY_JURISDICTION=DK
# BOOTSTRAP_MEMBER_EMAIL_DOMAINS=fiftysixty.com,spot.dog
# BOOTSTRAP_ADMIN_EMAILS=admin@fiftysixty.com
# BOOTSTRAP_ENTITY_PRIMARY_COLOR="#ed650f"
# BOOTSTRAP_ENTITY_SECONDARY_COLOR="#05a9ef"

SESSION_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
PLUGIN_ENCRYPTION_KEY=CHANGE_TO_STABLE_32_CHARACTER_RANDOM_KEY
WEBHOOK_SIGNING_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
RATE_LIMIT_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
METRICS_TOKEN=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
TRUST_PROXY=true

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_FROM=FiftySixty Contracts <contracts@fiftysixty.com>
WEBAUTHN_RP_ID=fiftysixty.com
WEBAUTHN_ORIGIN=https://contracts.fiftysixty.com

SIGNING_MODE=platform
PDF_SEAL_MODE=p12
PDF_SEAL_P12_PATH=/run/secrets/contracts-seal.p12
PDF_SEAL_P12_PASSWORD=CHANGE_ME
PDF_SEAL_NAME=ByteCrunch Contracts
PDF_SEAL_LOCATION=Copenhagen, Denmark
PDF_SEAL_CONTACT=contracts@fiftysixty.com

ARTIFACT_STORAGE_DRIVER=filesystem
ARTIFACT_STORAGE_PATH=/var/lib/bytecrunch/artifacts
ARTIFACT_RETENTION_DAYS=2555
# Environment fallback only. Prefer installing Google Drive in entity Settings.
EXECUTED_EXPORT_DRIVER=none
EXECUTED_EXPORT_ENTITY_IDS=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=/run/secrets/google-service-account.json
# GOOGLE_DRIVE_IMPERSONATE_EMAIL=drive-automation@fiftysixty.com
# GOOGLE_DRIVE_FOLDER_ID=folder-id
DELIVERY_MAX_ATTEMPTS=10
