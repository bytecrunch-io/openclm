PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://contracts:contracts@localhost:5432/contracts
AUTH_MODE=dev
DEV_USER_ID=local-admin
DEV_USER_EMAIL=admin@bytecrunch.local
DEV_USER_NAME=Local Admin
TENANT_LEGAL_NAME=ByteCrunch ApS
TENANT_BUSINESS_ADDRESS=
OIDC_ISSUER_URL=http://localhost:8080/realms/bytecrunch
OIDC_CLIENT_ID=bytecrunch-contracts
OIDC_CLIENT_SECRET=local-development-secret
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
SESSION_SECRET=change-this-in-production-to-at-least-32-characters
WEBHOOK_SIGNING_SECRET=local-webhook-secret
SIGNING_MODE=development
PDF_SEAL_MODE=development
PDF_SEAL_NAME=ByteCrunch Contracts
PDF_SEAL_LOCATION=Copenhagen, Denmark
PDF_SEAL_CONTACT=contracts@bytecrunch.local
# Production platform mode additionally requires:
# PDF_SEAL_P12_PATH=/run/secrets/contracts-seal.p12
# PDF_SEAL_P12_PASSWORD=<secret>
ARTIFACT_STORAGE_DRIVER=database
ARTIFACT_STORAGE_PATH=./var/artifacts
ARTIFACT_RETENTION_DAYS=2555
RATE_LIMIT_SECRET=change-this-in-production-to-at-least-32-characters
TRUST_PROXY=false
METRICS_TOKEN=change-this-in-production-to-at-least-32-characters
DELIVERY_MAX_ATTEMPTS=10
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
