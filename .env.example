PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://contracts:contracts@localhost:5432/contracts
AUTH_MODE=dev
DEV_USER_ID=local-admin
DEV_USER_EMAIL=admin@bytecrunch.local
DEV_USER_NAME=Local Admin
TENANT_LEGAL_NAME=ByteCrunch ApS
TENANT_BUSINESS_ADDRESS=
OIDC_ISSUER_URL=http://localhost:8080/realms/bytecrunch
# Optional endpoint overrides support providers such as Cognito, whose issuer
# and Hosted UI use different origins.
# OIDC_AUTHORIZATION_ENDPOINT=https://auth.example.com/oauth2/authorize
# OIDC_TOKEN_ENDPOINT=https://auth.example.com/oauth2/token
# OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=bytecrunch-contracts
OIDC_CLIENT_SECRET=local-development-secret
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
# Optional verified-domain bootstrap for one preconfigured customer entity.
# BOOTSTRAP_ENTITY_ID=example
# BOOTSTRAP_ENTITY_SLUG=example
# BOOTSTRAP_ENTITY_LEGAL_NAME=Example ApS
# BOOTSTRAP_MEMBER_EMAIL_DOMAINS=example.com
# BOOTSTRAP_ADMIN_EMAILS=contracts-admin@example.com
SESSION_SECRET=change-this-in-production-to-at-least-32-characters
PLUGIN_ENCRYPTION_KEY=change-this-in-production-to-a-stable-32-character-key
WEBHOOK_SIGNING_SECRET=local-webhook-secret
SIGNING_MODE=development
PDF_SEAL_MODE=development
PDF_SEAL_NAME=ByteCrunch Contracts
PDF_SEAL_LOCATION=Copenhagen, Denmark
PDF_SEAL_CONTACT=contracts@bytecrunch.local
# Production platform mode additionally requires:
# PDF_SEAL_P12_PATH=/run/secrets/contracts-seal.p12
# PDF_SEAL_P12_PASSWORD=<secret>
ARTIFACT_STORAGE_DRIVER=database
ARTIFACT_STORAGE_PATH=./var/artifacts
ARTIFACT_RETENTION_DAYS=2555
# Optional post-execution export. The storage above remains authoritative.
EXECUTED_EXPORT_DRIVER=none
EXECUTED_EXPORT_ENTITY_IDS=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=/run/secrets/google-service-account.json
# GOOGLE_DRIVE_IMPERSONATE_EMAIL=drive-automation@example.com
# GOOGLE_DRIVE_FOLDER_ID=<folder-id>
RATE_LIMIT_SECRET=change-this-in-production-to-at-least-32-characters
TRUST_PROXY=false
METRICS_TOKEN=change-this-in-production-to-at-least-32-characters
DELIVERY_MAX_ATTEMPTS=10
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
